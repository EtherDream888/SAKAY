# SAKAY Backend Server Environment Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client CORS Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Twilio SMS Configuration (Secondary Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Android SMS Gateway Configuration (capcom6/android-sms-gateway)
# When your gateway phone is connected to Wi-Fi, enter its IP address & port (e.g. http://192.168.1.50:8080)
SMS_GATEWAY_URL=
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SIM_NUMBER=


